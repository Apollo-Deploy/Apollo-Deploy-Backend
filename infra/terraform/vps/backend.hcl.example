# Create the bucket and enable versioning before the first hosted apply. Verify
# default encryption, public-access blocking, versioning, and operator/lock-file
# permissions independently. Keep this file free of credentials; authenticate
# Terraform with a short-lived operator role in the same account as Signal.
# The wizard rejects fields outside this exact set (plus optional kms_key_id),
# including alternate endpoints, profiles, and inline credentials.
# It also rejects endpoint override environment variables and disables endpoint
# URLs inherited from AWS shared profiles.
# This annotation is consumed by infra/setup.sh. The matching native
# allowed_account_ids value is enforced by the S3 backend itself; the wizard
# also compares STS and uses --expected-bucket-owner for its S3 preflight.
# apollo_expected_account_id = "123456789012"
# These bindings are generated by infra/setup.sh. Do not copy identities between
# deployments; an existing state lineage or target is immutable in normal use.
# apollo_deployment_id = "0123456789abcdef0123456789abcdef"
# apollo_state_lineage = "unbound"
# apollo_target_sha256 = "unbound"
bucket       = "replace-with-verified-terraform-state-bucket"
key          = "apollo/vps/terraform.tfstate"
region       = "replace-with-verified-aws-region"
encrypt      = true
use_lockfile = true
allowed_account_ids = ["123456789012"]

# Prefer a customer-managed key whose policy grants the operator role access.
# kms_key_id = "arn:aws:kms:REGION:ACCOUNT_ID:key/KEY_ID"
