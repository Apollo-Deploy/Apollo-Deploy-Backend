environment = "production"

server = {
  # Verify this exact host/port key out of band and add it to the operator's
  # default OpenSSH known_hosts before planning. Custom ports use [host]:port.
  host              = "203.0.113.10"
  user              = "deploy"
  ssh_port          = 22
  ssh_key_path      = "~/.ssh/id_ed25519"
  base_domain       = "apollodeploy.com"
  letsencrypt_email = "ops@apollodeploy.com"
}

cloudflare = {
  zone_id     = "0123456789abcdef0123456789abcdef"
  # Replace with the VPS's globally routable public IPv4 address.
  origin_ipv4 = "REPLACE_WITH_PUBLIC_IPV4"
  proxied     = true
}

# Replace these placeholders only with digests produced by each service's
# governed docker-publish.yml workflow. The wizard verifies the keyless
# signature, signed SLSA provenance, and exact source_commit before planning.
release_manifest = {
  platform = {
    image         = "ghcr.io/apollo-deploy/apollo-platform-api@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    source_commit = "0123456789abcdef0123456789abcdef01234567"
  }
  signal = {
    image         = "ghcr.io/apollo-deploy/apollo-signal-api@sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
    source_commit = "123456789abcdef0123456789abcdef012345678"
  }
  billing = {
    image         = "ghcr.io/apollo-deploy/apollo-billing-api@sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
    source_commit = "23456789abcdef0123456789abcdef0123456789"
  }
}

registry_credentials = {
  username = "github-user"
  # Use the narrowest GHCR read-only credential that can pull the three private
  # packages. This is an invalid sentinel: the wizard writes the real token to a
  # mode-0600 candidate file; never make this example directly deployable.
  token = "CHANGEME"
}

database = {
  # Every sentinel is intentionally invalid and unique so it documents the
  # privilege boundaries without becoming a reusable production credential.
  password                   = "CHANGEME-postgres"
  redis_password             = "CHANGEME-redis"
  platform_app_password      = "CHANGEME-platform-app"
  billing_app_password       = "CHANGEME-billing-app"
  billing_superuser_password = "CHANGEME-billing-superuser"
  signal_app_password        = "CHANGEME-signal-app"
  signal_superuser_password  = "CHANGEME-signal-superuser"
  platform_verifier_password = "CHANGEME-platform-verifier"
}

secrets = {
  session_secret          = "CHANGEME-session"
  auth_cookie_secret      = "CHANGEME-cookie"
  internal_service_secret = "CHANGEME-internal-service"
}

aws = {
  # Verify this account ID independently before planning. The AWS provider
  # refuses credentials for any other account.
  account_id = "123456789012"
  region     = "af-south-1"

  # Existing, operator-owned notification path. Terraform creates queue alarms
  # but deliberately does not own or silently subscribe the response channel.
  operator_alert_topic_arn = "arn:aws:sns:af-south-1:123456789012:apollo-production-ops-alerts"

  # Optional names for the one primary-region Signal bucket of each kind.
  # bucket_name_overrides = {
  #   template-media   = "apollo-template-media"
  #   project-archives = "apollo-signal-project-archives"
  # }
  # Trusted principals may assume the generated read/decrypt-only restore role.
  # support_restore_trusted_principal_arns = ["arn:aws:iam::123456789012:role/apollo-support"]
}

signal = {
  # The primary aws.region must be present. Select only the regions Apollo
  # Signal should expose for sending-domain and dedicated-IP provisioning.
  supported_regions = ["af-south-1"]

  # Keep this stable. Enabling or rotating it invalidates previously issued
  # unsigned or differently signed tracking and unsubscribe links.
  events_signing_secret = "CHANGEME-events-signing"
  webhook_secret_key    = ""

  # DMARC ingestion adds a rule to an operator-owned, already-active SES rule
  # set. Its protected bucket is retained while disabled; Terraform deliberately
  # does not replace the account-wide active receipt rule set.
  enable_dmarc_ingestion      = false
  dmarc_receipt_rule_set_name = ""

}

billing = {
  polar_api_key        = ""
  polar_webhook_secret = ""
}

# Optional encrypted offsite PostgreSQL backups.
backup = {
  r2_account_id        = ""
  r2_access_key_id     = ""
  r2_secret_access_key = ""
  r2_bucket            = ""
  restic_password      = ""
}
