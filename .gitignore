# macOS
.DS_Store

# Secrets
.env
.env.local

# Terraform
infra/terraform/environments/**/.terraform/
infra/terraform/environments/**/terraform.tfstate
infra/terraform/environments/**/terraform.tfstate.backup
infra/terraform/environments/**/terraform.tfstate.*.backup
infra/terraform/environments/**/terraform.tfvars
# Saved plans contain the complete proposed values, including cleartext secrets.
tfplan
*.tfplan
*.tfplan.*
# NOTE: .terraform.lock.hcl is intentionally committed (pinned provider hashes)

# Generated at runtime by the OAuth bootstrap step
infra/oauth-clients.json.active

# Apollo infrastructure operator configuration and derived runtime files
infra/config/local.env
infra/config/local.secrets.env
infra/config/vps.env
infra/config/vps.secrets.env
infra/config/vps.aws.env
infra/config/vps.known_hosts
infra/.runtime/
